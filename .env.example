# AI Code Review Agent - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: At least one AI provider must be configured
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o  # Optional, defaults to gpt-4o

# OR Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash  # Optional, defaults to gemini-2.5-flash

# OR Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5  # Optional, defaults to claude-sonnet-4-5

# =============================================================================
# OPTIONAL: Notification Services
# =============================================================================

# Enable/Disable Notifications
SEND_WHATSAPP=false  # Set to true to enable WhatsApp notifications
SEND_GOOGLE_CHAT=false  # Set to true to enable Google Chat notifications

# Google Chat Webhook (for notifications)
# Get this from: Google Chat Space → Apps and integrations → Configure webhooks
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=YYYYY&token=ZZZZZ

# WhatsApp Business API (for notifications)
# Get these from: https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_RECIPIENT_PHONE=1234567890  # Country code + number without + (e.g., 5491123456789 for Argentina)
WHATSAPP_API_VERSION=v18.0  # Optional, defaults to v18.0

# =============================================================================
# OPTIONAL: RAG (Retrieval Augmented Generation) Configuration
# =============================================================================

# Enable/disable RAG globally (default: true)
USE_RAG=true

# Vector database type (default: chroma)
# Currently supported: chroma
# Future: pinecone
VECTOR_DB_TYPE=chroma

# Path for ChromaDB storage (default: ./chroma_db)
CHROMA_DB_PATH=./chroma_db

# OpenAI Embedding Model (optional, for OpenAI embeddings)
# Used when OpenAI is selected for embeddings (priority: Gemini → OpenAI → Anthropic fallback)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
