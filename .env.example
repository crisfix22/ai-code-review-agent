# =============================================================================
# AI Code Review Agent - Environment Variables Configuration
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values (replace all YOUR_* placeholders)
# 3. Never commit the .env file to version control!
#
# =============================================================================
# REQUIRED: AI Provider Configuration
# =============================================================================
# You need at least ONE of the following AI providers configured:
# - OpenAI (recommended for best results)
# - Google Gemini (good alternative)
# - Anthropic Claude (excellent for code analysis)

# -----------------------------------------------------------------------------
# OpenAI Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
# Optional: Model to use (default: gpt-4o)
# Available models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Google Gemini Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional: Model to use (default: gemini-1.5-pro)
# Available models: gemini-1.5-pro, gemini-1.5-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# Anthropic Claude Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# Optional: Model to use (default: claude-sonnet-4-5)
CLAUDE_MODEL=claude-sonnet-4-5

# =============================================================================
# OPTIONAL: Notification Services
# =============================================================================
# Enable notifications by setting the corresponding flag to true
# and configuring the required credentials below

# -----------------------------------------------------------------------------
# Notification Toggles
# -----------------------------------------------------------------------------
# Set to "true" (lowercase) to enable, "false" to disable
SEND_WHATSAPP=false
SEND_GOOGLE_CHAT=false

# -----------------------------------------------------------------------------
# Google Chat Webhook Configuration
# -----------------------------------------------------------------------------
# Required only if SEND_GOOGLE_CHAT=true
# 
# How to get your webhook URL:
# 1. Open Google Chat: https://chat.google.com/
# 2. Create or open a space
# 3. Click space name → "Apps and integrations" → "Configure webhooks"
# 4. Create a new webhook and copy the URL
# 
# Format: https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=YYYYY&token=ZZZZZ
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE_ID/messages?key=YOUR_KEY&token=YOUR_TOKEN

# -----------------------------------------------------------------------------
# WhatsApp Business API Configuration
# -----------------------------------------------------------------------------
# Required only if SEND_WHATSAPP=true
# 
# How to get your credentials:
# 1. Go to Meta for Developers: https://developers.facebook.com/
# 2. Create a Business app and add WhatsApp product
# 3. Follow the setup wizard to get your credentials
# 
# See README.md for detailed setup instructions

# Access Token from Meta for Developers
# For testing: Use temporary token from "WhatsApp" → "API Setup"
# For production: Create System User and generate permanent token
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN_HERE

# Phone Number ID from Meta for Developers
# Found in "WhatsApp" → "API Setup" → "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID_HERE

# Recipient phone number (where notifications will be sent)
# Format: Country code + number WITHOUT + sign
# Examples:
#   - Argentina: 5491123456789
#   - USA: 15551234567
#   - Spain: 34612345678
WHATSAPP_RECIPIENT_PHONE=YOUR_RECIPIENT_PHONE_NUMBER

# Optional: WhatsApp API version (default: v18.0)
# Check latest version at: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_VERSION=v18.0

# =============================================================================
# NOTES
# =============================================================================
# - All values are case-sensitive
# - Remove spaces around the = sign
# - Use quotes only if your value contains special characters
# - For boolean values (SEND_*), use lowercase: "true" or "false"
# - Restart the server after changing environment variables
